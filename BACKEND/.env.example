# ─────────────────────────────────────────────────────────────────
# VEDBUS Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL via Prisma) ─────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vedbus?schema=public"

# ── JWT — Two separate secrets, never share between environments ──
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS — Comma-separated allowed origins ────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Seat Lock / Cache (Redis - Optional) ──────────────────────────
# If omitted or Redis is down, backend automatically falls back to in-memory TTL map
REDIS_URL=redis://localhost:6379

# ── Payment Gateway (Razorpay) — Fill when client provides ────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

